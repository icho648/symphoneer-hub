# Shared infrastructure
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres
REDIS_URL=redis://localhost:6379

# API
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Set to 1 only when exactly one trusted reverse proxy terminates the API connection.
TRUST_PROXY_HOPS=0
AUTH_MODE=dev
DEV_USER_ID=00000000-0000-0000-0000-000000000001
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
PAIRING_PEPPER=replace-with-at-least-32-random-characters
DEVICE_TOKEN_PEPPER=replace-with-a-different-32-character-secret

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_AUTH_MODE=dev

# Connector
HUB_API_URL=http://localhost:4000
HUB_WEBSOCKET_URL=ws://localhost:4000/v1/connectors/ws
SYMPHONEER_RUNTIME_URL=http://127.0.0.1:47100
PAIRING_CODE=
CONNECTOR_STATE_PATH=
CONNECTOR_POLL_INTERVAL_MS=2000
CONNECTOR_HEARTBEAT_INTERVAL_MS=10000
